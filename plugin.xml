<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="com.company.faceidnative"
        version="1.1.3">

    <name>FaceIDNative</name>
    <description>Offline FaceID with PT2 protected templates, native enrollment capture and Android active liveness (blink + head turn) before capture.</description>
    <license>MIT</license>

    <js-module src="www/FaceID.js" name="FaceID">
        <clobbers target="FaceIDNative" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="FaceIDPlugin">
                <param name="android-package" value="com.company.faceidnative.FaceIDPlugin" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.CAMERA" />
        </config-file>

        <framework src="com.google.mlkit:face-detection:16.1.7" />
        <framework src="org.tensorflow:tensorflow-lite:2.14.0" />

        <framework src="androidx.camera:camera-core:1.5.3" />
        <framework src="androidx.camera:camera-camera2:1.5.3" />
        <framework src="androidx.camera:camera-lifecycle:1.5.3" />
        <framework src="androidx.camera:camera-view:1.5.3" />
        <framework src="androidx.exifinterface:exifinterface:1.4.2" />

        <source-file src="src/android/FaceIDPlugin.java"
                     target-dir="app/src/main/java/com/company/faceidnative" />
        <source-file src="src/android/FaceCameraOverlay.java"
                     target-dir="app/src/main/java/com/company/faceidnative" />
        <source-file src="src/android/MobileFaceNetEngine.java"
                     target-dir="app/src/main/java/com/company/faceidnative" />
        <source-file src="src/android/TemplateProtector.java"
                     target-dir="app/src/main/java/com/company/faceidnative" />
        <source-file src="src/android/SecureProtectionStore.java"
                     target-dir="app/src/main/java/com/company/faceidnative" />

        <resource-file src="src/android/assets/facenet.tflite"
                       target="assets/facenet.tflite" />
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="FaceIDPlugin">
                <param name="ios-package" value="FaceIDPlugin" />
            </feature>
        </config-file>

        <preference name="FACEID_CAMERA_USAGE_DESCRIPTION"
                    default="A câmara é utilizada para verificar a identidade do trabalhador no controlo de assiduidade ou acesso." />

        <config-file target="*-Info.plist" parent="NSCameraUsageDescription">
            <string>$FACEID_CAMERA_USAGE_DESCRIPTION</string>
        </config-file>

        <framework src="Vision.framework" />
        <framework src="AVFoundation.framework" />
        <framework src="Security.framework" />
        <framework src="UIKit.framework" />
        <framework src="CoreGraphics.framework" />
        <framework src="ImageIO.framework" />

        <framework src="TensorFlowLiteObjC"
                   type="podspec"
                   spec="2.17.0" />

        <source-file src="src/ios/FaceIDPlugin.h" />
        <source-file src="src/ios/FaceIDPlugin.m" />
        <source-file src="src/ios/FaceNetEngineIOS.h" />
        <source-file src="src/ios/FaceNetEngineIOS.m" />
        <source-file src="src/ios/TemplateProtectorIOS.h" />
        <source-file src="src/ios/TemplateProtectorIOS.m" />
        <source-file src="src/ios/SecureProtectionStoreIOS.h" />
        <source-file src="src/ios/SecureProtectionStoreIOS.m" />

        <resource-file src="src/ios/facenet.tflite" />
    </platform>
</plugin>
